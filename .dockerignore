# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# Documentation
*.md
!README.md
docs/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Instance folder (will be created at runtime)
instance/

# Uploads (will be mounted as volume)
uploads/*
!uploads/.gitkeep

# Results (will be mounted as volume)
result/*
!result/.gitkeep

# Temporary files
*.tmp
*.temp
tmp/
temp/

# K8s similar folder (not needed for Docker)
k8s similar/

# Terraform files
terraform/
.terraform/
*.tfstate
*.tfstate.*

# Test data that's not needed
*.bak
*.ped
*.csv
data/

# SSL Certificates (mounted separately)
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key

# Development override (production uses base compose only)
# docker-compose.override.yml  # Uncomment to exclude from builds

# Plans and docs
*.plan.md
.cursor/plans/



