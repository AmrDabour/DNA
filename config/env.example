# ============================================================
# GenovaAI - Environment Configuration Example
# ============================================================
# Copy this file to .env in the project root and update values
# NEVER commit .env to version control!
# ============================================================

# ==================== Flask Configuration ====================
# IMPORTANT: Generate a secure key for production!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secure_secret_key_here_generate_with_python
FLASK_ENV=production
FLASK_DEBUG=0

# ==================== Application Settings ====================
DEBUG=False
PORT=5001

# ==================== Google Gemini API ====================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ==================== PostgreSQL Database ====================
# For Docker: use 'postgres' | For local: use 'localhost'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=genovaai
POSTGRES_USER=genovaai_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ==================== MongoDB Database ====================
# For Docker: use 'mongodb' | For local: use 'localhost'
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=genovaai
MONGO_USER=genovaai_mongo_user
MONGO_PASSWORD=your_secure_mongo_password_here

# ==================== Redis Cache & Sessions ====================
# Redis is used for:
# - VEP API response caching (7-day TTL)
# - Flask server-side sessions (7-day TTL)
# - AI agent chat memory (24-hour TTL)
# For Docker: use 'redis' | For local: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password_here  # Uncomment if Redis requires auth
REDIS_URL=redis://redis:6379/0

# ==================== Admin Account ====================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ==================== Connection Pool (Optional) ====================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==================== LangSmith Configuration (Optional) ====================
# Enable tracing for AI agent debugging
# Get API key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=genovaai-production

# ==================== AI Agent Settings (Optional) ====================
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=120
MEMORY_WINDOW_SIZE=20

# ==================== VEP Configuration (Optional) ====================
# Ensembl Variant Effect Predictor integration
VEP_ENABLED=true
VEP_CACHE_TTL=7
VEP_BATCH_SIZE=200
VEP_RATE_LIMIT=15
VEP_BASE_URL=https://rest.ensembl.org

# ==================== Docker Image Tag ====================
TAG=latest

# ==================== PgAdmin (Optional) ====================
# Uncomment to enable PgAdmin in docker-compose
# PGADMIN_EMAIL=admin@yourdomain.com
# PGADMIN_PASSWORD=your_pgadmin_password_here

# ==================== Environment Tag ====================
ENVIRONMENT=production

# ============================================================
# RabbitMQ & Celery Task Queue
# ============================================================
# Enables async task processing for:
# - Long-running SNP analysis
# - VEP batch annotations
# - AI predictions (physical traits, disease risk)
# - Scheduled maintenance tasks

CELERY_ENABLED=true
RABBITMQ_USER=genovaai
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
CELERY_BROKER_URL=amqp://genovaai:your_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Flower Monitoring Dashboard (optional)
FLOWER_USER=admin
FLOWER_PASSWORD=your_flower_password_here

# ============================================================
# QUICK START FOR LOCAL DEVELOPMENT
# ============================================================
# For local development without Docker, use these host values:
# POSTGRES_HOST=localhost
# MONGO_HOST=localhost
# REDIS_HOST=localhost
#
# For Docker development, keep the service names:
# POSTGRES_HOST=postgres
# MONGO_HOST=mongodb
# REDIS_HOST=redis
