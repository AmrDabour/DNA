# ============================================================
# GenovaAI - Kubernetes Secrets Environment File
# ============================================================
# Copy this file to k8s.env and fill in your values
# Then run: kubectl apply -k kubernetes-manifests/
# ============================================================

# Required - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Flask (auto-generated if empty)
FLASK_SECRET_KEY=change-me-in-production

# Database passwords (defaults work for local dev)
POSTGRES_USER=genovaai
POSTGRES_PASSWORD=local-postgres-pwd
POSTGRES_DB=genovaai
DATABASE_URL=postgresql://genovaai:local-postgres-pwd@postgres:5432/genovaai

# MongoDB (no auth for local dev)
MONGO_INITDB_ROOT_USERNAME=genovaai
MONGO_INITDB_ROOT_PASSWORD=local-mongo-pwd
MONGO_INITDB_DATABASE=genovaai
MONGO_URI=mongodb://mongodb:27017/genovaai
MONGODB_URI=mongodb://mongodb:27017/genovaai

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_DEFAULT_USER=genovaai
RABBITMQ_DEFAULT_PASS=local-rabbitmq-pwd
CELERY_BROKER_URL=amqp://genovaai:local-rabbitmq-pwd@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LangSmith (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=GenovaAI
