# Environment variables
.env
.env.*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/

# Uploaded data (user uploads - temporary)
uploads/

# Generated result files (temporary prediction results)
*_combined_prediction_results.json
*_region_prediction_results.json
*_simplified_results.json
*_genotypes.csv

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

# Backup files
*_backup.py
*.bak

# IDE
.idea/
*.swp
*.swo
# Note: .vscode/ is tracked to share workspace settings across machines

# Note: Model files (.pkl), data files (.csv) in hapmap_data/ and new_model/ 
# are INTENTIONALLY tracked because they are required for the app to work

# Project-specific ignores
k8s similar/

# SSL Certificates (DO NOT COMMIT)
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/.gitkeep

# Docker data volumes
data/postgres/
data/mongodb/
data/redis/

# Certbot
certbot/
# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
*.tfvars
*.tfvars.json
.terraform.lock.hcl

# Kubernetes Secrets (NEVER COMMIT!)
kubernetes-manifests/secrets.generated.yaml
kubernetes-manifests/secrets.local.yaml
kubernetes-manifests/secrets-configmap.yaml
kubernetes-manifests/k8s.env

# Local result tracking
result/
!result/.gitkeep
